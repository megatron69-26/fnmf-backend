# Cấu hình Secret và API Keys cho dự án (KHÔNG commit file .env thật lên git)

# JWT Secret dùng để ký token (Chuỗi ngẫu nhiên dài khoảng 32-64 ký tự)
JWT_SECRET=your_jwt_secret_here

# Alpha Vantage API Key (Đăng ký tại: https://www.alphavantage.co/)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# OpenAI API Key (Gemini hoặc OpenAI GPT)
OPENAI_API_KEY=your_openai_api_key_here
